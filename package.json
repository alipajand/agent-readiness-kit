{
  "name": "agent-readiness-kit",
  "version": "0.1.0",
  "description": "Audit whether a software repository is ready for AI coding agents",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "bin": {
    "ark": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "agents",
    "ai-agents",
    "agent-readiness",
    "claude-code",
    "cursor",
    "codex",
    "copilot",
    "cli",
    "audit",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alipajand/agent-readiness-kit.git"
  },
  "bugs": {
    "url": "https://github.com/alipajand/agent-readiness-kit/issues"
  },
  "homepage": "https://github.com/alipajand/agent-readiness-kit#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
